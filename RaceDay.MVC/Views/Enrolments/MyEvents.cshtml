@using System.Text.Json
@model JsonElement?

@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4 mb-5">

    <h1 class="fw-bold mb-2">My Race Entries</h1>

    <p class="text-muted mb-4">
        View the race categories you have entered.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }
    else if (Model.HasValue &&
    Model.Value.ValueKind == JsonValueKind.Array &&
    Model.Value.GetArrayLength() > 0)
    {
        <div class="row g-4">

            @foreach (var enrolment in Model.Value.EnumerateArray())
            {
                var enrolmentId =
                enrolment.GetProperty("enrolmentID").GetInt32();

                var categoryId =
                enrolment.GetProperty("categoryID").GetInt32();

                var raceNumber =
                enrolment.GetProperty("raceNumber").GetInt32();

                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body p-4">

                            <span class="badge bg-success mb-3">
                                Enrolled
                            </span>

                            <h4 class="fw-bold">
                                Race Entry #@enrolmentId
                            </h4>

                            <p class="text-muted">
                                Category ID: @categoryId
                            </p>

                            <p class="text-muted">
                                Race Number: @raceNumber
                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info">
            You have not entered any race categories yet.
        </div>
    }

    <a asp-controller="Categories"
       asp-action="Index"
       class="btn btn-primary mt-4">
        Browse Categories
    </a>

</div>