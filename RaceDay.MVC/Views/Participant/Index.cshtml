@{
    ViewData["Title"] = "Participant Dashboard";
}

<div class="container mt-5 mb-5">

    <div class="mb-4">
        <h1 class="fw-bold">
            Welcome, @ViewBag.FirstName!
        </h1>

        <p class="text-muted">
            Welcome to your RaceDay Participant Dashboard.
            Manage your sporting activities and event entries here.
        </p>
    </div>

    <div class="row g-4">

        <!-- Browse Events -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">Browse Events</h4>

                    <p class="text-muted">
                        Discover upcoming running, walking and cycling events.
                    </p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary w-100">
                        View Events
                    </a>
                </div>
            </div>
        </div>

        <!-- Browse Categories -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">Browse Categories</h4>

                    <p class="text-muted">
                        Explore available race distances and choose a category.
                    </p>

                    <a asp-controller="Categories"
                       asp-action="Index"
                       class="btn btn-primary w-100">
                        View Categories
                    </a>
                </div>
            </div>
        </div>

        <!-- My Events -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">My Events</h4>

                    <p class="text-muted">
                        View the events you have entered.
                    </p>

                    <a asp-controller="Enrolments"
                       asp-action="MyEvents"
                       class="btn btn-primary w-100">
                        View My Events
                    </a>
                </div>
            </div>
        </div>

        <!-- My Results -->
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold">My Results</h4>

                    <p class="text-muted">
                        View your sporting event results.
                    </p>

                    <a asp-controller="Results"
                       asp-action="Index"
                       class="btn btn-primary w-100">
                        View My Results
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>